# Copy to .env for running on your own computer (npm start reads it).
# On Fly.io / Render, set these as secrets / environment variables instead.

# --- Required in production ----------------------------------------------------
# The public address people use (https://… in production). Used in emails,
# Stripe redirects, and baked into the browser extension.
BASE_URL=http://localhost:8080
# Encrypts everyone's saved details. 32 random bytes: `openssl rand -hex 32`.
# BACK IT UP. If it's lost or changed, saved delivery details can't be read.
DATA_ENCRYPTION_KEY=
# These emails become admins when they sign up / log in (comma-separated).
ADMIN_EMAILS=you@example.com

# --- Server --------------------------------------------------------------------
PORT=8080
# DATABASE_PATH=./data/tcgcopbot.db
# Set to 1 behind a proxy/load balancer (Fly, Render) so rate limits see real IPs.
# TRUST_PROXY=1
# Other addresses that serve the same app (e.g. your fly.dev address as well as your domain).
# EXTRA_ORIGINS=https://tcgcopbot.fly.dev

# --- Your business -------------------------------------------------------------
APP_NAME=TCGCopBot
SUPPORT_EMAIL=support@example.com
PRICE_DISPLAY=A$19 / month
TRIAL_DAYS=7
# SIGNUPS_OPEN=1
# Once the extension is on the Chrome Web Store, link it here:
# CHROME_STORE_URL=https://chromewebstore.google.com/detail/…

# --- Payments (Stripe) ---------------------------------------------------------
# Without these, everyone stays on the free trial and admins can grant access.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ------------------------------------------------------------
# Needed for password resets and email alerts. Without it, emails are printed to the log.
RESEND_API_KEY=
EMAIL_FROM=TCGCopBot <alerts@yourdomain.com>

# --- Limits ----------------------------------------------------------------------
# MAX_PRODUCTS=50
# MAX_WATCH_ITEMS=25
# MAX_DEVICES=5
# SIGNUPS_PER_HOUR=10
# SESSION_DAYS=30

# --- Restock monitor ---------------------------------------------------------------
# MONITOR_ENABLED=1
# Seconds between checks of one product page (however many people watch it).
# MONITOR_URL_INTERVAL=60
# Seconds between any two requests to the same store.
# MONITOR_HOST_GAP=5
# Restock checks only fetch public web addresses. Set to 1 ONLY to test with a store on your own computer.
# MONITOR_ALLOW_PRIVATE=0
