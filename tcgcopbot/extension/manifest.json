{
  "manifest_version": 3,
  "name": "TCGCopBot Quick Checkout",
  "version": "1.0.0",
  "description": "⚡ Buy from your TCGCopBot dashboard: sets quantity, adds to bag, fills in checkout and stops at the final button for you to press.",
  "permissions": ["storage"],
  "host_permissions": [],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "TCGCopBot", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "options_page": "options.html",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": []
}
